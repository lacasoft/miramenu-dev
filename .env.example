# .env.example — variables de entorno del proyecto (solo nombres, SIN valores).
# En desarrollo y CI, `npm run env:init` crea el .env (gitignored) con secretos aleatorios
# para los contenedores locales. En producción los valores los da la plataforma.
# El API las valida al arrancar (apps/api/src/infrastructure/config/environment.ts) y falla
# nombrando la que falte o sea inválida, nunca su valor.

# --- API ---
PORT=
# Orígenes extra para CORS, separados por coma. El sitio público y sus subdominios (la PWA de cada
# restaurante) se aceptan siempre (ADR-0045); vacío = ninguno más.
CORS_ALLOWED_ORIGINS=
# Opcional (ms, por defecto 1000): espera máxima de cada chequeo de /health/dependencies.
HEALTH_CHECK_TIMEOUT_MS=
# Opcional (por defecto 0): proxies delante del API, para que el límite de login vea la IP real.
TRUST_PROXY_HOPS=

# --- Negocios y acceso (ADR-0010, ADR-0029, ADR-0033, ADR-0035) ---
# Base de las URLs de sucursal y del QR, solo el origen (p. ej. https://mirame.nu).
PUBLIC_SITE_URL=
# Origen de la app de admin: único Origin aceptado en escrituras del admin y base de las invitaciones.
ADMIN_APP_URL=
# Opcionales (por defecto 60 min y 12 h): sesión del admin sin uso y máxima.
ADMIN_SESSION_IDLE_MINUTES=
ADMIN_SESSION_ABSOLUTE_HOURS=
# Opcionales (por defecto 60 s y 24 h): caché de la resolución del QR y del subdominio (ADR-0016).
RESOLUTION_CACHE_REFRESH_SECONDS=
RESOLUTION_CACHE_TTL_HOURS=
# Opcionales (por defecto 60 s y 24 h): caché del menú publicado, que se sirve si cae Postgres (ADR-0016).
MENU_CACHE_REFRESH_SECONDS=
MENU_CACHE_TTL_HOURS=

# --- Postgres: una base, un esquema y un rol por contexto (ADR-0027) ---
# Solo para el contenedor local: contraseña del superusuario que crea roles y base.
POSTGRES_SUPERUSER_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# Solo contenedor local y tests: base aparte para los e2e (nunca igual a DB_NAME).
DB_TEST_NAME=
# Opcional (por defecto 5): conexiones máximas de cada contexto.
DB_POOL_MAX_PER_CONTEXT=
# Dueño de los esquemas: solo lo usan las migraciones, nunca el API.
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=
DB_BUSINESS_ACCESS_USER=
DB_BUSINESS_ACCESS_PASSWORD=
DB_CATALOG_USER=
DB_CATALOG_PASSWORD=
DB_DINERS_USER=
DB_DINERS_PASSWORD=
DB_INTERACTIONS_USER=
DB_INTERACTIONS_PASSWORD=
DB_MEASUREMENT_USER=
DB_MEASUREMENT_PASSWORD=

# --- Redis: cola y caché (ADR-0012, ADR-0017) ---
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# Opcional (ms, por defecto 100): espera máxima del cliente de caché.
REDIS_CACHE_TIMEOUT_MS=
# Opcional, solo contenedor local (por defecto 256mb).
REDIS_MAXMEMORY=
# Opcional (por defecto miramenu): prefijo de las colas de BullMQ; los tests usan uno propio.
QUEUE_PREFIX=

# --- Almacenamiento de objetos S3 (ADR-0006, ADR-0030) ---
# Solo contenedor local: puerto publicado de SeaweedFS.
S3_PORT=
S3_ENDPOINT=
S3_REGION=
# Bucket público de las variantes optimizadas: se lee sin credenciales.
S3_BUCKET=
# Bucket privado de los originales, distinto de S3_BUCKET: conservan su EXIF (ADR-0038).
S3_ORIGINALS_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional (por defecto false): rutas estilo path, necesarias con SeaweedFS.
S3_FORCE_PATH_STYLE=
# URL pública de donde los celulares leen los medios (nunca a través del API).
MEDIA_PUBLIC_BASE_URL=

# --- Medios y su worker (ADR-0006, ADR-0015, ADR-0038) ---
# Opcional (s, por defecto 600): vida de la URL firmada de subida.
MEDIA_UPLOAD_URL_TTL_SECONDS=
# Opcional (min, por defecto 10): un medio procesando más tiempo se marca como atorado.
MEDIA_STALLED_MINUTES=
# Opcional (por defecto 1): medios que el worker procesa a la vez.
MEDIA_WORKER_CONCURRENCY=
# Opcionales (por defecto ffmpeg y ffprobe del PATH): rutas de los binarios.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Correo SMTP (ADR-0023, ADR-0030) ---
SMTP_HOST=
SMTP_PORT=
# Opcional (por defecto false): TLS implícito.
SMTP_SECURE=
# Opcionales, en pareja: credenciales del proveedor de producción.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Solo contenedor local: puerto de la interfaz web y del API de Mailpit (usado por los tests).
MAILPIT_UI_PORT=

# --- Comensales: registro con código (ADR-0007, ADR-0039) ---
# Canal de los códigos, el mismo para todos los negocios: whatsapp o sms.
VERIFICATION_CHANNEL=
# Opcional (ms, por defecto 5000): espera máxima al proveedor; sin respuesta, el envío queda sin confirmar.
VERIFICATION_PROVIDER_TIMEOUT_MS=
# Opcional (por defecto https://api.twilio.com): en local, el simulador de compose.yaml.
TWILIO_API_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remitente: un número en E.164 (habilitado para el canal) o un Messaging Service (MG…).
TWILIO_FROM=
# Plantilla de Content (HX…) con el texto del mensaje y el código como variable 1.
TWILIO_CONTENT_SID=
# URL pública, sin query string, a la que Twilio manda los reportes de entrega firmados.
TWILIO_STATUS_CALLBACK_URL=
# Clave del HMAC que Redis guarda en lugar de cada código y de cada celular.
DINER_CODE_SECRET=
# Versión vigente del aviso de privacidad; el registro guarda la que aceptó el comensal.
PRIVACY_NOTICE_VERSION=
# Opcionales (por defecto 600 s, 5 intentos y 60 s): vigencia del código, intentos y espera para pedir otro.
VERIFICATION_CODE_TTL_SECONDS=
VERIFICATION_CODE_MAX_ATTEMPTS=
VERIFICATION_RESEND_SECONDS=
# Opcionales (por defecto 5 y 10 al día, 30 por hora): envíos por celular, por dispositivo y por IP.
VERIFICATION_SENDS_PER_PHONE_PER_DAY=
VERIFICATION_SENDS_PER_DEVICE_PER_DAY=
VERIFICATION_SENDS_PER_IP_PER_HOUR=
# Opcional (días, por defecto 90): duración de la sesión del comensal.
DINER_SESSION_DAYS=
# Solo contenedor local: puerto del simulador de Twilio (usado por los tests).
TWILIO_SIMULATOR_PORT=

# --- Interacciones: likes, comentarios y moderación (ADR-0040) ---
# Opcional (por defecto 5): comentarios que un comensal puede publicar o editar por hora.
COMMENTS_PER_DINER_PER_HOUR=
# Opcional (h, por defecto 24): un comentario en espera más tiempo se marca para sus moderadores.
COMMENT_OVERDUE_HOURS=
# Opcional (s, por defecto 5): cada cuánto el worker pasa a su cuenta los likes de los dispositivos recién registrados.
LIKE_TRANSFER_INTERVAL_SECONDS=

# --- Medición (ADR-0004, ADR-0012, ADR-0041) ---
# Opcional (por defecto 50000): lotes en espera a partir de los cuales se rechazan los nuevos (503).
MEASUREMENT_QUEUE_MAX_BATCHES=
# Opcional (por defecto 2): lotes que el worker de medición procesa a la vez.
MEASUREMENT_WORKER_CONCURRENCY=
